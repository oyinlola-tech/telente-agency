PORT=3000
NODE_ENV=development

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=telente
DB_POOL_SIZE=10

JWT_SECRET=change_this_in_production
JWT_EXPIRES_IN=7d

# OTP
OTP_TTL_MINUTES=10

# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_pass
SMTP_FROM="Telente <no-reply@telente.com>"
SMTP_TO=admin@telente.com
CONTACT_TO_EMAIL=admin@telente.com

# Admin seed
DEFAULT_ADMIN_EMAIL=admin@telente.local
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASS=admin123

# Comma-separated list
CORS_ORIGINS=https://www.telente.site
